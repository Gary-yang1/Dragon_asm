# ── Server ──────────────────────────────────────────────────────────────────
API_PORT=8080
# GIN_MODE: debug | release | test
GIN_MODE=debug
# Coarse request-body ceiling in bytes (default 8 MiB). Per-route caps are
# tighter — the discovery callback bounds itself at 4 MiB.
API_MAX_BODY_BYTES=8388608
# Comma-separated CIDRs/addresses of reverse proxies allowed to set
# X-Forwarded-For. Unset means trust nothing, so the audited client IP is the TCP
# peer and cannot be forged. Set this when terminating TLS at a proxy, otherwise
# every audit record shows the proxy's address.
# TRUSTED_PROXIES=10.0.0.0/8

# ── MySQL ───────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=asm
DB_PASSWORD=changeme
DB_NAME=asm
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
# Used by Makefile migrate-up / migrate-down (override if needed)
# DB_DSN=asm:changeme@tcp(localhost:3306)/asm?parseTime=true&loc=UTC&charset=utf8mb4

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────────────────────
# Both secrets are mandatory, must differ, and must be at least 32 bytes —
# shorter values leave every business route unwired (fail-closed).
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret-min-32-bytes
JWT_REFRESH_SECRET=replace-with-another-strong-random-secret-32b
# Go duration strings (e.g. 15m, 24h). Defaults: access 15m, refresh 24h.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=24h

# ── Discovery engines (no production defaults) ─────────────────────────────
# Passive route: Baiyan. Trusted origins must only come from process config.
DISCOVERY_PASSIVE_ENGINE_BASE_URL=http://localhost:9090
DISCOVERY_PASSIVE_ENGINE_TOKEN=replace-with-strong-passive-engine-token
# Deprecated compatibility aliases. Existing deployments may keep these during
# migration; the explicit passive variables above take precedence.
DISCOVERY_ENGINE_BASE_URL=
DISCOVERY_ENGINE_TOKEN=

# Active route: the owned AK/SK engine. ASM automatically creates and stores
# engine project bindings. The optional JSON map preserves legacy bindings.
# The service account needs project read/create permissions. Credentials and release
# policy are independent: configuring AK/SK alone never opens active dispatch.
DISCOVERY_ACTIVE_ENGINE_BASE_URL=
DISCOVERY_ACTIVE_ENGINE_ACCESS_KEY=
DISCOVERY_ACTIVE_ENGINE_SECRET_KEY=
DISCOVERY_ACTIVE_ENGINE_PROJECT_MAP=
# Active task release policy. Dispatch remains disabled unless explicitly true.
# Scope authorization, dangerous-address rejection, project isolation, active
# template caps, auditing and Web nopoc=true are always enforced. The active
# engine API does not currently accept per-task rate/concurrency settings;
# configure actual execution limits on the selected engine node.
DISCOVERY_ACTIVE_DISPATCH_ENABLED=false
DISCOVERY_ACTIVE_REQUIRE_APPROVAL=true
DISCOVERY_ACTIVE_REQUIRE_OWNERSHIP=true

# HMAC secret used by the API to authenticate Baiyan callbacks.
DISCOVERY_CALLBACK_SECRET=replace-with-strong-hmac-secret
# Stable engine identity stored on each TaskRun; this is a reference, not a secret.
DISCOVERY_CALLBACK_SECRET_REF=baiyan-primary
# Optional bounded JSON map for rotation, e.g. {"baiyan-old":"...","baiyan-primary":"..."}.
DISCOVERY_CALLBACK_SECRETS=
# Optional secret for historical TaskRuns whose callback_secret_ref is empty.
DISCOVERY_CALLBACK_LEGACY_SECRET=
# HMAC secret backing the DNS TXT domain-ownership challenge. Must be at least 32
# bytes. Without it, ownership verification is unavailable and active scanning
# is refused whenever DISCOVERY_ACTIVE_REQUIRE_OWNERSHIP=true.
# Changing it invalidates every published TXT record, so rotate deliberately.
OWNERSHIP_CHALLENGE_SECRET=replace-with-strong-ownership-secret-0123456789
# Trusted ASM origin. Code appends /api/v1/discovery/callback and run query IDs.
DISCOVERY_CALLBACK_BASE_URL=http://localhost:8080

# ── Baiyan provider adapters ────────────────────────────────────────────────
BAIYAN_ENGINE_PORT=9090
BAIYAN_QUEUE_SIZE=100
BAIYAN_WORKERS=2

# Passive provider contract:
# GET ?domain=<root>&limit=<n> -> {"subdomains":["www.example.com"]}
BAIYAN_PASSIVE_PROVIDER_NAME=certificate_transparency
BAIYAN_PASSIVE_PROVIDER_URL=
BAIYAN_PASSIVE_PROVIDER_TOKEN=
BAIYAN_PASSIVE_MAX_RESULTS=500

# Native FOFA provider. Obtain the email and API key from your FOFA account.
FOFA_EMAIL=
FOFA_KEY=
FOFA_MAX_RESULTS=1000

# Optional. Leave blank to use the system DNS resolver.
# Upstream DNS servers for engine lookups ("ip" or "ip:port", comma separated,
# at most 8), queried directly with failover. Empty uses the system resolver.
BAIYAN_DNS_RESOLVERS=
BAIYAN_DNS_PROVIDER_URL=
BAIYAN_DNS_PROVIDER_TOKEN=
BAIYAN_DNS_MAX_RESULTS=500

# ── Notification delivery ───────────────────────────────────────────────────
# Webhook is the only wired channel. Recipient URLs are operator-supplied, so
# every request goes through the SSRF-guarded client: internal addresses are
# refused at dial time, redirects are not followed, and both time and response
# size are bounded. There is nothing to configure — rules carry their own URLs.
# The email channel has no transport yet and fails loudly rather than silently
# recording an unsent notification.

# ── Retention ───────────────────────────────────────────────────────────────
# The worker archives and prunes audit logs, change events and callback payloads
# nightly at 03:00 on the "low" queue, using retention.DefaultPolicy(). Override
# a single run by enqueueing retention:run with a JSON payload.

# Online engine settings: generate secrets/engine-settings.key as 32 random raw bytes (chmod 600).
# API and Worker must share this key; never lose it while encrypted versions/jobs exist.
# For docker compose set: ENGINE_SETTINGS_KEY_FILE=/run/asm-secrets/engine-settings.key
ENGINE_SETTINGS_KEY_FILE=
